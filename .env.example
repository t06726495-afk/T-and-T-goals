# Copy this file to .env.local for local development and fill in real values there.
# .env.local is gitignored — never commit real secrets.
#
# In Vercel, set these under Project Settings → Environment Variables instead
# of committing a .env file.

# --- Client-side (safe to expose in the browser bundle) ---
# Only these two VITE_ prefixed values may ever reach client code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-only (read ONLY inside /api/* serverless functions, never imported by client code) ---
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=

# NOTE: the signup allowlist (the two emails allowed to create an account) is
# NOT a Vercel env var — a Postgres trigger can't read Vercel's environment.
# It's set directly in Supabase via SQL. See SETUP.md, Phase 2, step 5.
